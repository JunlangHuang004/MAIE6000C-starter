limit_req_zone $binary_remote_addr zone=nutrichat_requests:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=nutrichat_login:10m rate=1r/s;
server {
    listen 80;
    server_name __PUBLIC_IP__;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location / { return 308 https://__PUBLIC_IP__$request_uri; }
}
server {
    listen 443 ssl;
    server_name __PUBLIC_IP__;
    ssl_certificate /etc/letsencrypt/live/nutrichat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nutrichat/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 16k;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    location = / { return 302 /app; }
    location = /metrics { return 404; }
    location ~ ^/auth/(login|register)$ {
        limit_req zone=nutrichat_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
    }
    location / {
        limit_req zone=nutrichat_requests burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
        proxy_read_timeout 60s;
    }
}
