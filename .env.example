APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/maie6000c
AI_SERVICE_URL=http://ai:8100
WORKER_POLL_SECONDS=2.0
WORKER_REQUEST_TIMEOUT_SECONDS=20.0
API_HOST_PORT=8000
AI_HOST_PORT=8100
POSTGRES_HOST_PORT=5432

# Local HTTP development only. Public deployments must use Secure cookies and HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_PUBLIC_ORIGIN=http://localhost:8000
AUTH_REGISTRATION_ENABLED=true

# demo: strict English parser without API calls; qwen: cloud Qwen extraction
NUTRITION_PROVIDER=demo
DASHSCOPE_API_KEY=
# Copy the OpenAI-compatible base URL for your region/workspace from Model Studio.
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus
# Keep this below WORKER_REQUEST_TIMEOUT_SECONDS.
QWEN_TIMEOUT_SECONDS=12

# Optional model adapters; see docs/integration.md and docs/models-local-lab.md.
# Leave LLM_PROVIDER unset to preserve NUTRITION_PROVIDER and the Qwen settings above.
# A non-empty LLM_PROVIDER overrides NUTRITION_PROVIDER for every service.
# LLM_PROVIDER=heuristic is the strict, six-food English demo parser, with no API calls.
# Keep private lab configurations outside the repository and select one using
# MODEL_ENV_FILE plus docker compose --env-file with compose.models.yaml.
#
# HKUST GenAI: replace the placeholder only in your private local .env.
# LLM_PROVIDER=hkust
# LLM_BASE_URL=https://hkust.azure-api.net/hkust-genai/v1
# LLM_MODEL=gemini-2.5-flash-lite
# LLM_API_KEY=replace_with_your_own_hkust_key
# LLM_API_KEY_HEADER=api-key
# LLM_TIMEOUT_SECONDS=180
# WORKER_REQUEST_TIMEOUT_SECONDS=210
# MODEL_LAB_PORT=8004
#
# Ollama on the Mac host, reached from Docker Desktop; no account or API key needed.
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=180
# WORKER_REQUEST_TIMEOUT_SECONDS=210
# MODEL_LAB_PORT=8004
